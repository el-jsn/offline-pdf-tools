{
  "name": "offline-pdf-tools",
  "private": true,
  "version": "0.1.4",
  "type": "module",
  "scripts": {
    "dev": "node scripts/build-image-worker.mjs && node scripts/prepare-assets.mjs && vite --host 127.0.0.1 --port 1420 --strictPort",
    "build": "node scripts/prepare-assets.mjs && vite build",
    "desktop": "tauri dev",
    "package": "node scripts/release.mjs",
    "lint:ui": "node --check src/main.js",
    "assets": "node scripts/prepare-assets.mjs",
    "check:engine": "node scripts/check-engine.mjs",
    "build:desktop": "node scripts/build-image-worker.mjs && node scripts/check-engine.mjs && npm run build",
    "release": "npm run package",
    "version:set": "node scripts/set-version.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0",
    "pdfjs-dist": "6.4.299"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "vite": "^7.0.0"
  },
  "engines": {
    "node": ">=22.16.0"
  }
}
